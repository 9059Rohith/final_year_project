APP_ENV=development
MONGODB_URL=mongodb://localhost:27017
DB_NAME=speakeasy_asd
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
