CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_BYTES=10485760
EXPOSE_DEV_CODES=true
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
